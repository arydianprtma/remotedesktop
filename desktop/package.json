{
  "name": "remote-desk-client",
  "version": "1.1.1",
  "description": "Remote Desk desktop client for unattended and attended remote access",
  "main": "src/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/arydianprtma/remotedesktop.git"
  },
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "dist": "electron-builder --win --publish always"
  },
  "build": {
    "appId": "com.arydian.remotedesk",
    "productName": "Remote Desk",
    "publish": [
      {
        "provider": "github",
        "owner": "arydianprtma",
        "repo": "remotedesktop"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "**/native/**"
    ],
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src/native/InputInjector.exe",
        "to": "src/native/InputInjector.exe"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true
    },
    "directories": {
      "output": "dist"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^33.2.1",
    "electron-builder": "^26.18.0"
  }
}
